<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="gui.ControlPanel" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <VBox prefWidth="250.0" style="-fx-background-color: rgba(7, 115, 238, 0.2);" BorderPane.alignment="CENTER">
            <children>
                <Label text="Control">
                    <VBox.margin>
                        <Insets left="10.0" top="10.0" />
                    </VBox.margin>
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <TabPane minHeight="250.0" prefWidth="250.0" style="-fx-background-color: rgba(0,0,0,0.3);" tabClosingPolicy="UNAVAILABLE">
                    <tabs>
                        <Tab onSelectionChanged="#modeChangeAct" style="-fx-background-color: #3b97ff63;" text="Simulation">
                            <content>
                                <AnchorPane minHeight="0.0" minWidth="0.0" prefWidth="200.0">
                                    <children>
                                        <VBox prefHeight="250.0" prefWidth="250.0" style="-fx-background-color: rgba(8, 136, 227, 0.3);">
                                            <children>
                                                <Label text="Simulation Time:" />
                                                <Label fx:id="simTime" text="0" style="-fx-font-size: 20px;" />
                                                <HBox>
                                                    <children>
                                                        <Button fx:id="simPlay" mnemonicParsing="false" onAction="#simPlayAct" prefWidth="110.0" text="Start">
                                                            <HBox.margin>
                                                                <Insets right="10.0" />
                                                            </HBox.margin>
                                                        </Button>
                                                        <Button fx:id="simPause" mnemonicParsing="false" onAction="#simPauseAct" prefWidth="110.0" text="Pause">
                                                            <HBox.margin>
                                                                <Insets />
                                                            </HBox.margin>
                                                        </Button>
                                                        <Button fx:id="simTest" mnemonicParsing="false" onAction="#simTestAct" prefWidth="110.0" text="Test Button">
                                                            <HBox.margin>
                                                                <Insets right="10.0" />
                                                            </HBox.margin>
                                                        </Button>
                                                    </children>
                                                    <VBox.margin>
                                                        <Insets bottom="10.0" top="5.0" />
                                                    </VBox.margin>
                                                </HBox>
                                            </children>
                                            <padding>
                                                <Insets left="10.0" top="10.0" />
                                            </padding>
                                                <Label text="Filter Option" />
                                                <ComboBox fx:id="filterOnOff" onAction="#switchFilterAct" prefWidth="150.0" />
                                                <Label text="Color" />
                                                <ComboBox fx:id="filterColor" prefWidth="150.0" />
                                                <Label text="Speed Limit" />
                                                <TextField fx:id="filterSpeed" promptText="Enter speed" onAction="#speedFilterAct" prefWidth="150.0"/>
                                        </VBox>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>
                        <Tab onSelectionChanged="#modeChangeAct" style="-fx-background-color: #3b97ff63;" text="Add Vehicle">
                            <content>
                                <AnchorPane minHeight="0.0" minWidth="0.0" prefWidth="250.0">
                                    <children>
                                        <VBox prefHeight="250.0" prefWidth="250.0" style="-fx-background-color: rgba(8, 136, 227, 0.3);">
                                            <children>
                                                <Label text="Number of Vehicle" />
                                                <TextField fx:id="injectVehNum" promptText="Enter number of vehicles (1-300)" prefWidth="100.0"/>
                                                <Label text="Color" />
                                                <ComboBox fx:id="vehColor" prefWidth="150.0" />
                                                <Label text="Route" />
                                                <ComboBox fx:id="injectVehRoute" onAction="#chosenRouteAct" prefWidth="150.0" />
                                                <Label text=" " />
                                                <Button fx:id="vehInject" mnemonicParsing="false" onAction="#vehInjectAct" text="Inject Vehicle" prefWidth="150.0"/>
                                            </children>
                                            <padding>
                                                <Insets left="10.0" right="10.0" top="10.0" />
                                            </padding>
                                        </VBox>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>
                        <Tab onSelectionChanged="#modeChangeAct" style="-fx-background-color: #3b97ff63;" text="Traffic Light">
                            <content>
                                <AnchorPane minHeight="0.0" minWidth="0.0" prefWidth="200.0">
                                    <children>
                                        <VBox prefHeight="250.0" prefWidth="250.0" style="-fx-background-color: rgba(8, 136, 227, 0.3);">
                                            <children>
                                                <Label text="Traffic Light ID" />
                                                <ComboBox fx:id="tlIDs" onAction="#chosenTLAct" prefWidth="150.0" />
                                                <Label text="Phase duration" />
                                                <TextField fx:id="tlPhaseTime" promptText="Enter seconds"/>
                                                <Label text=" " />
                                                <Button fx:id="tlSetTime" mnemonicParsing="false" onAction="#tlSetTimeAct" text="Set time" prefWidth="150.0" />
                                                <Button fx:id="tlNPhase" mnemonicParsing="false" onAction="#tlNPhaseAct" text="Next Phase" prefWidth="150.0" />
                                                <Label text=" " />
                                                <Button fx:id="tlNPhaseAll" mnemonicParsing="false" onAction="#tlNPhaseAllAct" text="Next Phase All" prefWidth="150.0" />
                                            </children>
                                            <padding>
                                                <Insets left="10.0" right="10.0" top="10.0" />
                                            </padding>
                                        </VBox>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
                <Label text="Statistic">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets left="10.0" top="10.0" />
                    </VBox.margin>
                </Label>
                <TabPane prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE">
                    <tabs>
                        <Tab style="-fx-background-color: #3b97ff63;" text="Simulation">
                            <content>
                                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                                    <children>
                                        <LineChart fx:id="staSim" prefHeight="150.0" prefWidth="250.0" style="-fx-background-color: rgba(20,11,50,0.5);">
                                            <xAxis>
                                                <CategoryAxis side="BOTTOM" />
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis side="LEFT" />
                                            </yAxis>
                                            <padding>
                                                <Insets right="5.0" top="10.0" />
                                            </padding>
                                        </LineChart>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>
                        <Tab style="-fx-background-color: #3b97ff63;" text="Vehicle">
                            <content>
                                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                                    <children>
                                        <TableView fx:id="staVehTable" prefHeight="150.0" prefWidth="250.0" style="-fx-background-color: rgba(55,0,0,0.5);">
                                            <columns>
                                                <TableColumn fx:id="staVehID" prefWidth="83.0" text="ID" />
                                                <TableColumn fx:id="staVehRoute" prefWidth="83.0" text="Route" />
                                                <TableColumn fx:id="staVehSpeed" prefWidth="83.0" text="Speed" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>
                        <Tab style="-fx-background-color: #3b97ff63;" text="Traffic Light">
                            <content>
                                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                                    <children>
                                        <TableView fx:id="staTLTable" prefHeight="150.0" prefWidth="250.0">
                                            <columns>
                                                <TableColumn fx:id="staTLID" prefWidth="100.0" text="ID" />
                                                <TableColumn fx:id="staTLPhase" prefWidth="150.0" text="Phase" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
                <HBox prefWidth="250.0" spacing="10.0">
                    <children>
                        <MenuButton fx:id="expType" mnemonicParsing="false" onAction="#expTypeAct" prefWidth="100.0" text="Type">
                            <items>
                                <MenuItem fx:id="expTypePDF" mnemonicParsing="false" text="PDF" />
                                <MenuItem fx:id="expTypeCSV" mnemonicParsing="false" text="CSV" />
                            </items>
                        </MenuButton>
                        <Button fx:id="expBtn" mnemonicParsing="false" onAction="#expBtnAct" prefWidth="100.0" text="Export" />
                    </children>
                    <padding>
                        <Insets left="19.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="mapContainer" style="-fx-background-color: lightgreen;" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>
